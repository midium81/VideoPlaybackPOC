<Window
    x:Class="CustomVideoPlayerPOC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomVideoPlayerPOC"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image x:Name="VideoImage" Stretch="Uniform" />
        <StackPanel
            Grid.Row="1"
            Margin="0,2,0,0"
            VerticalAlignment="Top"
            Background="#80000000">
            <Grid Margin="8,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="Retention folder:" />
                <TextBox
                    x:Name="RetentionFolderText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    ToolTip="Downloads are kept here and reused on the next application start." />
                <Button
                    x:Name="BtnBrowseFolder"
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    Padding="8,2"
                    Click="BtnBrowseFolder_Click"
                    Content="Browse..." />
                <Button
                    x:Name="BtnOpenFolder"
                    Grid.Column="3"
                    Margin="4,0,0,0"
                    Padding="8,2"
                    Click="BtnOpenFolder_Click"
                    Content="Open" />
            </Grid>
            <Grid Margin="8,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="DownloadProgressBar"
                    Height="10"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0" />
                <TextBlock
                    x:Name="DownloadStatusText"
                    Grid.Column="1"
                    MinWidth="230"
                    Margin="8,0,0,0"
                    Foreground="White"
                    Text="Idle"
                    TextAlignment="Right" />
            </Grid>
            <StackPanel Height="48" Orientation="Horizontal">
                <Button
                    x:Name="BtnPlay"
                    Margin="4"
                    Click="BtnPlay_Click"
                    Content="Play" />
                <Button
                    x:Name="BtnPause"
                    Margin="4"
                    Click="BtnPause_Click"
                    Content="Pause" />
                <Button
                    x:Name="BtnStep"
                    Margin="4"
                    Click="BtnStep_Click"
                    Content="Step" />
                <Button
                    x:Name="BtnSeek10"
                    Margin="4"
                    Click="BtnSeek10_Click"
                    Content="Seek +10s" />
                <Button
                    x:Name="BtnFF2"
                    Margin="4"
                    Click="BtnFF2_Click"
                    Content="2x" />
                <Button
                    x:Name="BtnFF4"
                    Margin="4"
                    Click="BtnFF4_Click"
                    Content="4x" />
                <Slider
                    x:Name="PositionSlider"
                    Width="400"
                    Margin="8"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="PositionSlider_ValueChanged" />
                <TextBlock
                    x:Name="StatusText"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
