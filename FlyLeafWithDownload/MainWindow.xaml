<Window
    x:Class="FlyLeafWithDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
    xmlns:local="clr-namespace:FlyLeafWithDownload"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Flyleaf player with background download"
    Width="960"
    Height="600"
    Background="#FF1E1E1E"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <Button
                x:Name="OpenButton"
                Width="80"
                Click="OpenButton_Click"
                Content="Open"
                DockPanel.Dock="Right" />
            <TextBox
                x:Name="UrlTextBox"
                Margin="0,0,8,0"
                VerticalContentAlignment="Center" />
        </DockPanel>

        <fl:FlyleafHost
            x:Name="Host"
            Grid.Row="1"
            Margin="8,0,8,0" />

        <Grid Grid.Row="2" Margin="8,6,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="CurTimeText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="White"
                Text="00:00:00" />
            <Slider
                x:Name="SeekSlider"
                Grid.Column="1"
                Margin="8,0,8,0"
                IsMoveToPointEnabled="True"
                Maximum="1000"
                Minimum="0"
                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
            <TextBlock
                x:Name="DurationText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="White"
                Text="00:00:00" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="8"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="70"
                Margin="4,0"
                Click="Backward_Click"
                Content="-10s" />
            <Button
                Width="90"
                Margin="4,0"
                Click="PrevFrame_Click"
                Content="Prev frame" />
            <Button
                x:Name="PlayPauseButton"
                Width="70"
                Margin="4,0"
                Click="PlayPause_Click"
                Content="Play" />
            <Button
                Width="90"
                Margin="4,0"
                Click="NextFrame_Click"
                Content="Next frame" />
            <Button
                Width="70"
                Margin="4,0"
                Click="Forward_Click"
                Content="+10s" />
            <TextBlock
                Margin="16,0,4,0"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Speed" />
            <ComboBox
                x:Name="SpeedCombo"
                Width="70"
                SelectionChanged="SpeedCombo_SelectionChanged" />
        </StackPanel>
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Foreground="#FFB0B0B0"
            Text="Idle" />
    </Grid>
</Window>
